# wing_facade -- the CAD kit laid over villa_wing.part's shell. Placed in island.txt at the
# wing's own origin and yaw, so every coordinate here is the wing's local frame: walls at x +/-5
# and z +/-4 rising to the wall top at y 3.75, and the veranda at z -4.6 with its posts running
# from y 0.15 to y 3.15.
#
# The shell's cylinder veranda posts, its teak door and its five painted window rects all stay
# exactly where they are; the kit sits over them rather than replacing them. Each wall_column is
# scaled to the veranda's own 3 m post height -- 0.652 brings the kit's 4.6 m shaft down to that,
# and 0.95 across still leaves a 0.63 m column comfortably fatter than the 0.45 m post it hides.
# The front eaves get eleven roof_edge_run pieces a metre apart along the eave line at z -4.7,
# which is where the hip wedge's shallow edge actually sits (its front face, not the wall face).

# veranda columns over the shell's four cylinder posts, z -4.6
piece models/own/arch/wall_column.obj   -3.500  0.150  -4.600   0.950 0.652 0.950    0.0 0.0 0.0   1.67 1.73 1.83  tex plaster_smooth 0.8
piece models/own/arch/wall_column.obj   -1.200  0.150  -4.600   0.950 0.652 0.950    0.0 0.0 0.0   1.67 1.73 1.83  tex plaster_smooth 0.8
piece models/own/arch/wall_column.obj    1.200  0.150  -4.600   0.950 0.652 0.950    0.0 0.0 0.0   1.67 1.73 1.83  tex plaster_smooth 0.8
piece models/own/arch/wall_column.obj    3.500  0.150  -4.600   0.950 0.652 0.950    0.0 0.0 0.0   1.67 1.73 1.83  tex plaster_smooth 0.8

# front door, over the shell's 1.3 x 2.6 dark rect at z -4.0 from y 0.15
piece models/own/arch/plain_door.obj     0.000  0.150  -4.000   1.000 1.180 1.000    0.0 0.0 0.0   1.47 1.25 0.88  tex planks_weathered 2.5

# windows over the shell's five painted rects, opening centre lifted to land near y 2.15
piece models/own/arch/window_small.obj   3.000  1.270  -4.000   1.000 1.100 1.000    0.0 0.0 0.0   1.67 1.73 1.83  tex plaster_smooth 0.8
piece models/own/arch/window_small.obj  -3.000  1.270  -4.000   1.000 1.100 1.000    0.0 0.0 0.0   1.67 1.73 1.83  tex plaster_smooth 0.8
piece models/own/arch/window_small.obj   0.000  1.270   4.000   1.000 1.100 1.000  180.0 0.0 0.0   1.67 1.73 1.83  tex plaster_smooth 0.8
piece models/own/arch/window_small.obj   5.000  1.270   0.000   1.000 1.100 1.000  270.0 0.0 0.0   1.67 1.73 1.83  tex plaster_smooth 0.8
piece models/own/arch/window_small.obj  -5.000  1.270   0.000   1.000 1.100 1.000   90.0 0.0 0.0   1.67 1.73 1.83  tex plaster_smooth 0.8

# cornice at the wall top, y 3.75, all four walls
piece models/own/arch/cornice_run.obj    0.000  3.750  -4.000  10.000 1.000 1.000    0.0 0.0 0.0   1.67 1.73 1.83  tex plaster_smooth 0.8
piece models/own/arch/cornice_run.obj    0.000  3.750   4.000  10.000 1.000 1.000  180.0 0.0 0.0   1.67 1.73 1.83  tex plaster_smooth 0.8
piece models/own/arch/cornice_run.obj    5.000  3.750   0.000   8.000 1.000 1.000  270.0 0.0 0.0   1.67 1.73 1.83  tex plaster_smooth 0.8
piece models/own/arch/cornice_run.obj   -5.000  3.750   0.000   8.000 1.000 1.000   90.0 0.0 0.0   1.67 1.73 1.83  tex plaster_smooth 0.8

# roof tile edge along the front eaves, eleven runs a metre apart at the hip wedge's low edge
piece models/own/arch/roof_edge_run.obj -5.000  3.750  -4.700   1.000 1.000 1.000    0.0 0.0 0.0   0.42 1.53 1.97  tex roof_tile 1.2
