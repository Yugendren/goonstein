# pool_house_facade -- the CAD kit laid over pool_house.part's shell. Placed in island.txt at the
# pool house's own origin and yaw, so every coordinate here is its local frame: walls at x +/-4.5
# and z +/-2.5 rising to the parapet top at y 3.95, three open arches on the -z face at x -3, 0, 3.
#
# The shell's three arch openings are already 1.8 m wide with a round head springing from y 0.2 --
# exactly what arched_opening was modelled for -- so each goes on at scale 1 with its base on the
# springing line; nothing about the shell's jambs or half-cylinder heads needs to change underneath
# it. The front parapet gets a proper balustrade instead of the shell's plain box coping: eight
# runs a metre apart with a post capping each end. There is no step at the arches -- the shell's
# floor plate and the sand outside it are at the same height -- so this file has no stair_run in
# it; adding one would put a floating flight of stairs in front of a threshold that isn't there.

# three arches over the shell's own arch openings
piece models/own/arch/arched_opening.obj -3.000  0.200  -2.500   1.000 1.000 1.000    0.0 0.0 0.0   1.67 1.73 1.83  tex plaster_smooth 0.8
piece models/own/arch/arched_opening.obj  0.000  0.200  -2.500   1.000 1.000 1.000    0.0 0.0 0.0   1.67 1.73 1.83  tex plaster_smooth 0.8
piece models/own/arch/arched_opening.obj  3.000  0.200  -2.500   1.000 1.000 1.000    0.0 0.0 0.0   1.67 1.73 1.83  tex plaster_smooth 0.8

# cornice below the parapet, y 3.60, all four walls
piece models/own/arch/cornice_run.obj     0.000  3.600  -2.500   9.000 1.000 1.000    0.0 0.0 0.0   1.67 1.73 1.83  tex plaster_smooth 0.8
piece models/own/arch/cornice_run.obj     0.000  3.600   2.500   9.000 1.000 1.000  180.0 0.0 0.0   1.67 1.73 1.83  tex plaster_smooth 0.8
piece models/own/arch/cornice_run.obj     4.500  3.600   0.000   5.000 1.000 1.000  270.0 0.0 0.0   1.67 1.73 1.83  tex plaster_smooth 0.8
piece models/own/arch/cornice_run.obj    -4.500  3.600   0.000   5.000 1.000 1.000   90.0 0.0 0.0   1.67 1.73 1.83  tex plaster_smooth 0.8

# front parapet balustrade, y 3.95, eight runs a metre apart with a post at each end
piece models/own/arch/balustrade_run.obj -3.500  3.950  -2.500   1.000 1.000 1.000    0.0 0.0 0.0   1.67 1.73 1.83  tex plaster_smooth 0.8
piece models/own/arch/balustrade_run.obj -2.500  3.950  -2.500   1.000 1.000 1.000    0.0 0.0 0.0   1.67 1.73 1.83  tex plaster_smooth 0.8
piece models/own/arch/balustrade_run.obj -1.500  3.950  -2.500   1.000 1.000 1.000    0.0 0.0 0.0   1.67 1.73 1.83  tex plaster_smooth 0.8
piece models/own/arch/balustrade_run.obj -0.500  3.950  -2.500   1.000 1.000 1.000    0.0 0.0 0.0   1.67 1.73 1.83  tex plaster_smooth 0.8
piece models/own/arch/balustrade_run.obj  0.500  3.950  -2.500   1.000 1.000 1.000    0.0 0.0 0.0   1.67 1.73 1.83  tex plaster_smooth 0.8
piece models/own/arch/balustrade_run.obj  1.500  3.950  -2.500   1.000 1.000 1.000    0.0 0.0 0.0   1.67 1.73 1.83  tex plaster_smooth 0.8
piece models/own/arch/balustrade_run.obj  2.500  3.950  -2.500   1.000 1.000 1.000    0.0 0.0 0.0   1.67 1.73 1.83  tex plaster_smooth 0.8
piece models/own/arch/balustrade_run.obj  3.500  3.950  -2.500   1.000 1.000 1.000    0.0 0.0 0.0   1.67 1.73 1.83  tex plaster_smooth 0.8
piece models/own/arch/balustrade_post.obj -4.200  3.950  -2.500   1.000 1.000 1.000    0.0 0.0 0.0   1.67 1.73 1.83  tex plaster_smooth 0.8
piece models/own/arch/balustrade_post.obj  4.200  3.950  -2.500   1.000 1.000 1.000    0.0 0.0 0.0   1.67 1.73 1.83  tex plaster_smooth 0.8
